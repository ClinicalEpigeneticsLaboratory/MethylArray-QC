// Tests for the BATCH_EFFECT process (modules/batch_effect.nf).
//
// All tests run in stub mode – no containers needed.
// The process uses an `each column` input and outputs dynamic glob patterns:
//   ${column}_*.json   (arity: 1..*)
//
// The process uses an `each` input (column) and outputs a dynamic glob:
//   ${column}_*.json   (arity: 1..*)
// A `stub:` block in batch_effect.nf creates `${column}_stub.json`, which
// satisfies the glob pattern in stub mode.
//
// In a process test the `each` input is provided as a single scalar value;
// the fan-out behaviour (one task per column) is tested at the subworkflow level.

nextflow_process {

    name "Test Process BATCH_EFFECT"
    script "modules/batch_effect.nf"
    process "BATCH_EFFECT"

    // ----------------------------------------------------------------
    // Happy path
    // ----------------------------------------------------------------

    test("Happy path: column=Sentrix_ID produces output JSON") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = file("${projectDir}/tests/test_data/sample_sheet_large.csv")
                input[2] = "Sentrix_ID"
                input[3] = file("${projectDir}/tests/test_data/stub.json")
                input[4] = "en"
                """
            }
        }

        then {
            assert process.success
        }
    }

    test("Happy path: column=Sentrix_Position produces output JSON") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = file("${projectDir}/tests/test_data/sample_sheet_large.csv")
                input[2] = "Sentrix_Position"
                input[3] = file("${projectDir}/tests/test_data/stub.json")
                input[4] = "en"
                """
            }
        }

        then {
            assert process.success
        }
    }

    // ----------------------------------------------------------------
    // Edge cases
    // ----------------------------------------------------------------

    test("Edge case: small sample sheet (5 samples) accepted") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = file("${projectDir}/tests/test_data/sample_sheet_small.csv")
                input[2] = "Sentrix_ID"
                input[3] = file("${projectDir}/tests/test_data/stub.json")
                input[4] = "en"
                """
            }
        }

        then {
            assert process.success
        }
    }

    test("Edge case: custom grouping column (Sample_Group)") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = file("${projectDir}/tests/test_data/sample_sheet_large.csv")
                input[2] = "Sample_Group"
                input[3] = file("${projectDir}/tests/test_data/stub.json")
                input[4] = "en"
                """
            }
        }

        then {
            assert process.success
        }
    }

    // ----------------------------------------------------------------
    // Snapshot
    // ----------------------------------------------------------------

    test("Snapshot: BATCH_EFFECT output channel structure – Sentrix_ID column") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = file("${projectDir}/tests/test_data/sample_sheet_large.csv")
                input[2] = "Sentrix_ID"
                input[3] = file("${projectDir}/tests/test_data/stub.json")
                input[4] = "en"
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
