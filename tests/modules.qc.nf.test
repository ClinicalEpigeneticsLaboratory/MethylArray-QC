// Tests for the QC process (modules/QC.nf).
//
// All tests run in stub mode – no IDAT files or Docker containers needed.
// Stub mode skips the R/SeSAME script and creates empty output files
// matching the declared patterns, letting us validate channel wiring,
// output naming and publishDir configuration.
//
// Input catalogue used:
//   tests/test_data/idats/               – empty placeholder IDAT directory
//   tests/test_data/sample_sheet_small.csv – 5-sample sheet
//   tests/test_data/sample_sheet_large.csv – 15-sample sheet

nextflow_process {

    name "Test Process QC"
    script "modules/QC.nf"
    process "QC"

    // ----------------------------------------------------------------
    // Happy path
    // ----------------------------------------------------------------

    test("Happy path: QC runs successfully and emits qc.parquet and qc.json") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/idats")
                input[1] = 4
                input[2] = file("${projectDir}/tests/test_data/sample_sheet_small.csv")
                """
            }
        }

        then {
            assert process.success
            assert process.out.qc_parquet.size() == 1
            assert process.out.qc_json.size()    == 1
            assert process.out.qc_parquet[0].toString().endsWith("qc.parquet")
            assert process.out.qc_json[0].toString().endsWith("qc.json")
        }
    }

    // ----------------------------------------------------------------
    // Edge cases
    // ----------------------------------------------------------------

    test("Edge case: cpus=1 – single-threaded QC") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/idats")
                input[1] = 1
                input[2] = file("${projectDir}/tests/test_data/sample_sheet_small.csv")
                """
            }
        }

        then {
            assert process.success
            assert process.out.qc_parquet.size() == 1
            assert process.out.qc_json.size()    == 1
        }
    }

    test("Edge case: large sample sheet (15 samples) does not change output file names") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/idats")
                input[1] = 8
                input[2] = file("${projectDir}/tests/test_data/sample_sheet_large.csv")
                """
            }
        }

        then {
            assert process.success
            assert process.out.qc_parquet[0].toString().endsWith("qc.parquet")
            assert process.out.qc_json[0].toString().endsWith("qc.json")
        }
    }

    test("Edge case: sample sheet with Sex and Age columns accepted") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/idats")
                input[1] = 4
                input[2] = file("${projectDir}/tests/test_data/sample_sheet_with_age_and_sex.csv")
                """
            }
        }

        then {
            assert process.success
        }
    }

    // ----------------------------------------------------------------
    // Snapshot
    // ----------------------------------------------------------------

    test("Snapshot: QC output channels structure") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/idats")
                input[1] = 4
                input[2] = file("${projectDir}/tests/test_data/sample_sheet_small.csv")
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
