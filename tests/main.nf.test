nextflow_pipeline {

    name "Test Workflow main.nf"
    script "main.nf"

    test("Should run without failures") {
        options "-stub"
        when {
            params {
                input        = "${projectDir}/tests/test_data/idats"
                sample_sheet = "${projectDir}/tests/test_data/sample_sheet_small.csv"
                output       = "${outputDir}"
            }
        }

        then {
            assert workflow.success
        }

    }

}
