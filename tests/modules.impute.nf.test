// Tests for the IMPUTE process (modules/impute.nf).
//
// All tests run in stub mode – no Parquet files or Python containers needed.
// The process emits four outputs:
//   imputed_mynorm.parquet       → imputed_mynorm channel
//   impute_nan_per_sample.parquet → nan_per_sample channel
//   impute_nan_per_probe.parquet  → nan_per_probe channel
//   imputation_summary.json       → imputation_summary_path channel

nextflow_process {

    name "Test Process IMPUTE"
    script "modules/impute.nf"
    process "IMPUTE"

    // ----------------------------------------------------------------
    // Happy path
    // ----------------------------------------------------------------

    test("Happy path: IMPUTE runs with knn imputer and default thresholds") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = 0.2
                input[2] = 0.2
                input[3] = "knn"
                """
            }
        }

        then {
            assert process.success
            assert process.out.imputed_mynorm.size()          == 1
            assert process.out.nan_per_sample.size()          == 1
            assert process.out.nan_per_probe.size()           == 1
            assert process.out.imputation_summary_path.size() == 1
            assert process.out.imputed_mynorm[0].toString().endsWith("imputed_mynorm.parquet")
            assert process.out.nan_per_sample[0].toString().endsWith("impute_nan_per_sample.parquet")
            assert process.out.nan_per_probe[0].toString().endsWith("impute_nan_per_probe.parquet")
            assert process.out.imputation_summary_path[0].toString().endsWith("imputation_summary.json")
        }
    }

    // ----------------------------------------------------------------
    // Edge cases – threshold values
    // ----------------------------------------------------------------

    test("Edge case: high probe threshold (p_threshold=0.5) permits more NaN per probe") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = 0.5
                input[2] = 0.2
                input[3] = "knn"
                """
            }
        }

        then {
            assert process.success
            assert process.out.imputed_mynorm.size() == 1
        }
    }

    test("Edge case: high sample threshold (s_threshold=0.5) permits more NaN per sample") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = 0.2
                input[2] = 0.5
                input[3] = "knn"
                """
            }
        }

        then {
            assert process.success
            assert process.out.imputed_mynorm.size() == 1
        }
    }

    test("Edge case: strict thresholds (p_threshold=0.05, s_threshold=0.05)") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = 0.05
                input[2] = 0.05
                input[3] = "knn"
                """
            }
        }

        then {
            assert process.success
        }
    }

    test("Edge case: both thresholds at maximum (p=0.5, s=0.5)") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = 0.5
                input[2] = 0.5
                input[3] = "knn"
                """
            }
        }

        then {
            assert process.success
        }
    }

    // ----------------------------------------------------------------
    // Edge cases – imputer types
    // ----------------------------------------------------------------

    test("Edge case: imputer_type=soft") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = 0.2
                input[2] = 0.2
                input[3] = "soft"
                """
            }
        }

        then {
            assert process.success
        }
    }

    // ----------------------------------------------------------------
    // Snapshot
    // ----------------------------------------------------------------

    test("Snapshot: IMPUTE output channels structure") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = 0.2
                input[2] = 0.2
                input[3] = "knn"
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
