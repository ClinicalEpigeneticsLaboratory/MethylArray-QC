// Tests for the BETA_DISTRIBUTION process (modules/beta_distribution.nf).
//
// All tests run in stub mode – no containers needed.
// The process emits two named outputs:
//   beta_distribution.json   → beta_distr_plot channel
//   random_cpgs_to_plot.json → n_rand_cpgs_path channel
//
// The `n_rand_cpgs` parameter controls how many CpG sites are randomly
// sampled for the beta-value distribution plot.

nextflow_process {

    name "Test Process BETA_DISTRIBUTION"
    script "modules/beta_distribution.nf"
    process "BETA_DISTRIBUTION"

    // ----------------------------------------------------------------
    // Happy path
    // ----------------------------------------------------------------

    test("Happy path: n_rand_cpgs=10000 (default)") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = 10000
                input[2] = "en"
                """
            }
        }

        then {
            assert process.success
            assert process.out.beta_distr_plot.size()  == 1
            assert process.out.n_rand_cpgs_path.size() == 1
            assert process.out.beta_distr_plot[0].toString().endsWith("beta_distribution.json")
            assert process.out.n_rand_cpgs_path[0].toString().endsWith("random_cpgs_to_plot.json")
        }
    }

    // ----------------------------------------------------------------
    // Edge cases – n_rand_cpgs range
    // ----------------------------------------------------------------

    test("Edge case: n_rand_cpgs=100 (very small sample)") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = 100
                input[2] = "en"
                """
            }
        }

        then {
            assert process.success
            assert process.out.beta_distr_plot.size()  == 1
            assert process.out.n_rand_cpgs_path.size() == 1
        }
    }

    test("Edge case: n_rand_cpgs=1000 (small sample)") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = 1000
                input[2] = "en"
                """
            }
        }

        then {
            assert process.success
        }
    }

    test("Edge case: n_rand_cpgs=100000 (large sample – performance test)") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = 100000
                input[2] = "en"
                """
            }
        }

        then {
            assert process.success
            assert process.out.beta_distr_plot.size() == 1
        }
    }

    test("Edge case: n_rand_cpgs=1 (boundary minimum)") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = 1
                input[2] = "en"
                """
            }
        }

        then {
            assert process.success
        }
    }

    // ----------------------------------------------------------------
    // report_language (input[2])
    //
    // Stub mode does not run bin/beta_distribution.py, so this covers the wiring
    // only: the language reaches the process and the emitted filenames stay
    // language-independent (report.py resolves plots by name). The Polish plot
    // labels themselves are verified statically by `make i18n_check`.
    // ----------------------------------------------------------------

    test("report_language: 'pl' does not change the emitted filenames") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = 10000
                input[2] = "pl"
                """
            }
        }

        then {
            assert process.success
            assert process.out.beta_distr_plot[0].toString().endsWith("beta_distribution.json")
            assert process.out.n_rand_cpgs_path[0].toString().endsWith("random_cpgs_to_plot.json")
        }
    }

    // ----------------------------------------------------------------
    // Snapshot
    // ----------------------------------------------------------------

    test("Snapshot: BETA_DISTRIBUTION output channels structure") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = 10000
                input[2] = "en"
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
