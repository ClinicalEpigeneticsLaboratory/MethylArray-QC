// Test-environment Nextflow configuration loaded by nf-test (see nf-test.config).
// This file intentionally omits production-only settings (report {}, dag {},
// Nextflow execution reports) that are irrelevant during nf-test runs.

docker {
    enabled = true
}

process {
    // Matches modules: QC, PREPROCESS, SEX_INFERENCE, CTRL_FLUORESCENCE_DATA
    withLabel: "r_sesame" {
        container = "janbinkowski96/methyl-array-qc-r"
    }

    // Matches module: EPIGENETIC_AGE_INFERENCE
    withLabel: "r_clock" {
        container = "janbinkowski96/methyl-array-qc-r-clock"
    }

    // Matches modules: IMPUTE, ANOMALY_DETECTION, BATCH_EFFECT, BETA_DISTRIBUTION,
    //                  NAN_DISTRIBUTION_PER_SAMPLE, NAN_DISTRIBUTION_PER_PROBE, PCA,
    //                  EPIGENETIC_AGE_PLOTS, CTRL_FLUORESCENCE_PLOTS, REPORT,
    //                  ADDITIONAL_VALIDATORS_INIT, ADDITIONAL_VALIDATORS_AFTER_IMPUTE
    withLabel: "python" {
        container = "janbinkowski96/methyl-array-qc-python"
    }
}

plugins {
    id 'nf-schema@2.3.0'
}

// Safe default for params.output.
// Individual test `when { params { output = "results" } }` blocks override this,
// but having a non-null default prevents `publishDir` and `beforeScript "mkdir -p ..."`
// directives from receiving a null value when a test does not set it explicitly
// (e.g. main.nf.test).
params {
    output = "results"
}
