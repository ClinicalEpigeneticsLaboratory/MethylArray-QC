// Tests for the NAN_DISTRIBUTION_PER_SAMPLE process
// (modules/nan_distribution_per_sample.nf).
//
// All tests run in stub mode – no containers needed.
// The process produces dynamic output files with a wildcard pattern:
//   nan_distribution_per_sample_*.json  (arity: 1..*)
//
// The output pattern is nan_distribution_per_sample_*.json (arity: 1..*).
// A `stub:` block in nan_distribution_per_sample.nf creates:
//   nan_distribution_per_sample_stub.json  → satisfies the wildcard pattern
//
// The number of output JSON files in real execution depends on how many
// grouping columns are present in the sample sheet (one per column + overall).

nextflow_process {

    name "Test Process NAN_DISTRIBUTION_PER_SAMPLE"
    script "modules/nan_distribution_per_sample.nf"
    process "NAN_DISTRIBUTION_PER_SAMPLE"

    // ----------------------------------------------------------------
    // Happy path
    // ----------------------------------------------------------------

    test("Happy path: QC parquet + small sample sheet") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = file("${projectDir}/tests/test_data/sample_sheet_small.csv")
                """
            }
        }

        then {
            assert process.success
        }
    }

    test("Happy path: QC parquet + large sample sheet (15 samples)") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = file("${projectDir}/tests/test_data/sample_sheet_large.csv")
                """
            }
        }

        then {
            assert process.success
        }
    }

    // ----------------------------------------------------------------
    // Edge cases
    // ----------------------------------------------------------------

    test("Edge case: sample sheet with Sex and Age columns – more grouping columns") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = file("${projectDir}/tests/test_data/sample_sheet_with_age_and_sex.csv")
                """
            }
        }

        then {
            assert process.success
        }
    }

    test("Edge case: boundary sample sheet (10 samples)") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = file("${projectDir}/tests/test_data/sample_sheet_boundary_10.csv")
                """
            }
        }

        then {
            assert process.success
        }
    }

    // ----------------------------------------------------------------
    // Snapshot
    // ----------------------------------------------------------------

    test("Snapshot: NAN_DISTRIBUTION_PER_SAMPLE output channel structure") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = file("${projectDir}/tests/test_data/sample_sheet_small.csv")
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
