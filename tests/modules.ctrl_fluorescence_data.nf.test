// Tests for the CTRL_FLUORESCENCE_DATA process
// (modules/ctrl_fluorescence_data.nf).
//
// All tests run in stub mode – no IDAT files or R/SeSAME containers needed.
// The process emits two named outputs:
//   ctrl_fluorescence.parquet       → ctrl_fluorescence_data_path channel
//   ctrl_unique_probe_types.json    → ctrl_fluorescence_unique_probe_types channel
//
// The `metric` parameter controls which fluorescence summary statistic is
// computed: "total" (sum) or "max" (maximum) per control probe type.

nextflow_process {

    name "Test Process CTRL_FLUORESCENCE_DATA"
    script "modules/ctrl_fluorescence_data.nf"
    process "CTRL_FLUORESCENCE_DATA"

    // ----------------------------------------------------------------
    // Happy path
    // ----------------------------------------------------------------

    test("Happy path: metric=total (default)") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/idats")
                input[1] = file("${projectDir}/tests/test_data/sample_sheet_small.csv")
                input[2] = 4
                input[3] = "total"
                """
            }
        }

        then {
            assert process.success
            assert process.out.ctrl_fluorescence_data_path.size()          == 1
            assert process.out.ctrl_fluorescence_unique_probe_types.size() == 1
            assert process.out.ctrl_fluorescence_data_path[0].toString().endsWith("ctrl_fluorescence.parquet")
            assert process.out.ctrl_fluorescence_unique_probe_types[0].toString().endsWith("ctrl_unique_probe_types.json")
        }
    }

    // ----------------------------------------------------------------
    // Edge cases – metric variants
    // ----------------------------------------------------------------

    test("Edge case: metric=max") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/idats")
                input[1] = file("${projectDir}/tests/test_data/sample_sheet_small.csv")
                input[2] = 4
                input[3] = "max"
                """
            }
        }

        then {
            assert process.success
            assert process.out.ctrl_fluorescence_data_path.size()          == 1
            assert process.out.ctrl_fluorescence_unique_probe_types.size() == 1
        }
    }

    // ----------------------------------------------------------------
    // Edge cases – cpu counts
    // ----------------------------------------------------------------

    test("Edge case: cpus=1 – single-threaded fluorescence extraction") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/idats")
                input[1] = file("${projectDir}/tests/test_data/sample_sheet_small.csv")
                input[2] = 1
                input[3] = "total"
                """
            }
        }

        then {
            assert process.success
        }
    }

    test("Edge case: large sample sheet (15 samples)") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/idats")
                input[1] = file("${projectDir}/tests/test_data/sample_sheet_large.csv")
                input[2] = 8
                input[3] = "total"
                """
            }
        }

        then {
            assert process.success
            assert process.out.ctrl_fluorescence_data_path.size() == 1
        }
    }

    test("Edge case: sample sheet with Sex and Age columns") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/idats")
                input[1] = file("${projectDir}/tests/test_data/sample_sheet_with_age_and_sex.csv")
                input[2] = 4
                input[3] = "total"
                """
            }
        }

        then {
            assert process.success
        }
    }

    // ----------------------------------------------------------------
    // Snapshot
    // ----------------------------------------------------------------

    test("Snapshot: CTRL_FLUORESCENCE_DATA output channels structure") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/idats")
                input[1] = file("${projectDir}/tests/test_data/sample_sheet_small.csv")
                input[2] = 4
                input[3] = "total"
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
