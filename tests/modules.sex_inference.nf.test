// Tests for the SEX_INFERENCE process (modules/sex_inference.nf).
//
// All tests run in stub mode – no R/SeSAME containers needed.
// The process emits one unnamed output:
//   inferred_sex.json
//
// Note: for sex inference to produce meaningful results in real execution,
// the sample sheet should contain a "Sex" column with FEMALE/MALE values.
// Stub mode validates channel wiring independent of content.

nextflow_process {

    name "Test Process SEX_INFERENCE"
    script "modules/sex_inference.nf"
    process "SEX_INFERENCE"

    // ----------------------------------------------------------------
    // Happy path
    // ----------------------------------------------------------------

    test("Happy path: SEX_INFERENCE runs and emits inferred_sex.json") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = 4
                input[2] = file("${projectDir}/tests/test_data/sample_sheet_with_age_and_sex.csv")
                """
            }
        }

        then {
            assert process.success
            assert process.out[0].size() == 1
            assert process.out[0][0].toString().endsWith("inferred_sex.json")
        }
    }

    // ----------------------------------------------------------------
    // Edge cases
    // ----------------------------------------------------------------

    test("Edge case: cpus=1 – single-threaded sex inference") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = 1
                input[2] = file("${projectDir}/tests/test_data/sample_sheet_with_age_and_sex.csv")
                """
            }
        }

        then {
            assert process.success
            assert process.out[0].size() == 1
        }
    }

    test("Edge case: sample sheet without Sex column still accepted by process signature") {
        // In real execution this would produce a warning or use predicted sex only.
        // Stub mode validates that the process accepts the input without erroring at
        // the Nextflow orchestration level.
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = 4
                input[2] = file("${projectDir}/tests/test_data/sample_sheet_small.csv")
                """
            }
        }

        then {
            assert process.success
        }
    }

    test("Edge case: large dataset (15 samples) does not change output file name") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = 8
                input[2] = file("${projectDir}/tests/test_data/sample_sheet_large.csv")
                """
            }
        }

        then {
            assert process.success
            assert process.out[0][0].toString().endsWith("inferred_sex.json")
        }
    }

    // ----------------------------------------------------------------
    // Snapshot
    // ----------------------------------------------------------------

    test("Snapshot: SEX_INFERENCE output channel structure") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = 4
                input[2] = file("${projectDir}/tests/test_data/sample_sheet_with_age_and_sex.csv")
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
