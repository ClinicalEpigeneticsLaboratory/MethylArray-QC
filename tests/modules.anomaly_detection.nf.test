// Tests for the ANOMALY_DETECTION process (modules/anomaly_detection.nf).
//
// All tests run in stub mode – no Parquet files or Python containers needed.
// The process emits:
//   ao_results.parquet → ao_results channel
//   ao_plot.json       → ao_plot channel
//
// The `contamination` parameter accepts either the string "auto" or a float
// in the range (0, 0.5], as documented in the sklearn IsolationForest docs.

nextflow_process {

    name "Test Process ANOMALY_DETECTION"
    script "modules/anomaly_detection.nf"
    process "ANOMALY_DETECTION"

    // ----------------------------------------------------------------
    // Happy path
    // ----------------------------------------------------------------

    test("Happy path: contamination=auto (default)") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = "auto"
                """
            }
        }

        then {
            assert process.success
            assert process.out.ao_results.size() == 1
            assert process.out.ao_plot.size()    == 1
            assert process.out.ao_results[0].toString().endsWith("ao_results.parquet")
            assert process.out.ao_plot[0].toString().endsWith("ao_plot.json")
        }
    }

    // ----------------------------------------------------------------
    // Edge cases – contamination float values
    // ----------------------------------------------------------------

    test("Edge case: contamination=0.05 (low outlier rate)") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = 0.05
                """
            }
        }

        then {
            assert process.success
            assert process.out.ao_results.size() == 1
            assert process.out.ao_plot.size()    == 1
        }
    }

    test("Edge case: contamination=0.1 (moderate outlier rate)") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = 0.1
                """
            }
        }

        then {
            assert process.success
        }
    }

    test("Edge case: contamination=0.5 (maximum allowed outlier rate)") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = 0.5
                """
            }
        }

        then {
            assert process.success
            assert process.out.ao_results.size() == 1
            assert process.out.ao_plot.size()    == 1
        }
    }

    test("Edge case: contamination=0.01 (very low – nearly all samples inliers)") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = 0.01
                """
            }
        }

        then {
            assert process.success
        }
    }

    // ----------------------------------------------------------------
    // Snapshot
    // ----------------------------------------------------------------

    test("Snapshot: ANOMALY_DETECTION output channels structure") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = "auto"
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
