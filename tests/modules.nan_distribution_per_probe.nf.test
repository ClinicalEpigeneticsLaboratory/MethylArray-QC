// Tests for the NAN_DISTRIBUTION_PER_PROBE process
// (modules/nan_distribution_per_probe.nf).
//
// All tests run in stub mode – no containers needed.
// The process emits one unnamed output:
//   nan_distribution_per_probe.json
//
// The `nan_per_probe_n_cpgs` parameter controls how many CpG probes are
// randomly sampled to visualise the NaN distribution across probes.

nextflow_process {

    name "Test Process NAN_DISTRIBUTION_PER_PROBE"
    script "modules/nan_distribution_per_probe.nf"
    process "NAN_DISTRIBUTION_PER_PROBE"

    // ----------------------------------------------------------------
    // Happy path
    // ----------------------------------------------------------------

    test("Happy path: default n_cpgs=1000") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = 1000
                input[2] = "en"
                """
            }
        }

        then {
            assert process.success
            assert process.out[0].size() == 1
            assert process.out[0][0].toString().endsWith("nan_distribution_per_probe.json")
        }
    }

    // ----------------------------------------------------------------
    // Edge cases – n_cpgs range
    // ----------------------------------------------------------------

    test("Edge case: n_cpgs=100 (small sample)") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = 100
                input[2] = "en"
                """
            }
        }

        then {
            assert process.success
            assert process.out[0].size() == 1
        }
    }

    test("Edge case: n_cpgs=10000 (larger sample)") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = 10000
                input[2] = "en"
                """
            }
        }

        then {
            assert process.success
        }
    }

    test("Edge case: n_cpgs=50000 (large sample – performance boundary)") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = 50000
                input[2] = "en"
                """
            }
        }

        then {
            assert process.success
        }
    }

    test("Edge case: n_cpgs=1 (boundary minimum)") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = 1
                input[2] = "en"
                """
            }
        }

        then {
            assert process.success
        }
    }

    // ----------------------------------------------------------------
    // Snapshot
    // ----------------------------------------------------------------

    test("Snapshot: NAN_DISTRIBUTION_PER_PROBE output channel structure") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/stub.parquet")
                input[1] = 1000
                input[2] = "en"
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
