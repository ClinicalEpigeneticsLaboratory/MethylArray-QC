// Tests for the PREPROCESS process (modules/preprocess.nf).
//
// All tests run in stub mode – no IDAT files or R/SeSAME containers needed.
// The process emits:
//   raw_mynorm.parquet              → raw_mynorm_path channel
//   preprocessing_data_summary.json → preprocess_summary_path channel

nextflow_process {

    name "Test Process PREPROCESS"
    script "modules/preprocess.nf"
    process "PREPROCESS"

    // ----------------------------------------------------------------
    // Happy path
    // ----------------------------------------------------------------

    test("Happy path: PREPROCESS runs with default QCDPB prep code") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/idats")
                input[1] = 4
                input[2] = "QCDPB"
                input[3] = false
                input[4] = "mean"
                input[5] = file("${projectDir}/tests/test_data/sample_sheet_small.csv")
                """
            }
        }

        then {
            assert process.success
            assert process.out.raw_mynorm_path.size()         == 1
            assert process.out.preprocess_summary_path.size() == 1
            assert process.out.raw_mynorm_path[0].toString().endsWith("raw_mynorm.parquet")
            assert process.out.preprocess_summary_path[0].toString().endsWith("preprocessing_data_summary.json")
        }
    }

    // ----------------------------------------------------------------
    // Edge cases – prep_code variants
    // ----------------------------------------------------------------

    test("Edge case: prep_code=SQCDPB (extended SeSAME preprocessing pipeline)") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/idats")
                input[1] = 4
                input[2] = "SQCDPB"
                input[3] = false
                input[4] = "mean"
                input[5] = file("${projectDir}/tests/test_data/sample_sheet_small.csv")
                """
            }
        }

        then {
            assert process.success
            assert process.out.raw_mynorm_path.size() == 1
        }
    }

    test("Edge case: prep_code=Q (minimal preprocessing)") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/idats")
                input[1] = 4
                input[2] = "Q"
                input[3] = false
                input[4] = "mean"
                input[5] = file("${projectDir}/tests/test_data/sample_sheet_small.csv")
                """
            }
        }

        then {
            assert process.success
        }
    }

    // ----------------------------------------------------------------
    // Edge cases – collapse_prefix flag
    // ----------------------------------------------------------------

    test("Edge case: collapse_prefix=true with method=mean") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/idats")
                input[1] = 4
                input[2] = "QCDPB"
                input[3] = true
                input[4] = "mean"
                input[5] = file("${projectDir}/tests/test_data/sample_sheet_small.csv")
                """
            }
        }

        then {
            assert process.success
            assert process.out.raw_mynorm_path.size() == 1
        }
    }

    test("Edge case: collapse_prefix=true with method=median") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/idats")
                input[1] = 4
                input[2] = "QCDPB"
                input[3] = true
                input[4] = "median"
                input[5] = file("${projectDir}/tests/test_data/sample_sheet_small.csv")
                """
            }
        }

        then {
            assert process.success
        }
    }

    test("Edge case: cpus=1 – single-threaded preprocessing") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/idats")
                input[1] = 1
                input[2] = "QCDPB"
                input[3] = false
                input[4] = "mean"
                input[5] = file("${projectDir}/tests/test_data/sample_sheet_small.csv")
                """
            }
        }

        then {
            assert process.success
        }
    }

    // ----------------------------------------------------------------
    // Snapshot
    // ----------------------------------------------------------------

    test("Snapshot: PREPROCESS output channels structure") {
        options "-stub"

        when {
            params {
                output = "results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/test_data/idats")
                input[1] = 4
                input[2] = "QCDPB"
                input[3] = false
                input[4] = "mean"
                input[5] = file("${projectDir}/tests/test_data/sample_sheet_small.csv")
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
