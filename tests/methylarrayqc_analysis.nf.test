                input[10] = "Sentrix_ID,Sentrix_Position"
                input[11] = "knn"
                input[12] = "auto"
                input[13] = 10000
                input[14] = 1000
                input[15] = 10
                input[16] = 5
                input[17] = "Sentrix_ID,Sentrix_Position"
                input[18] = 5
                input[19] = false
                input[20] = false
                input[21] = "HannumG2013"
                """
            }
        }

        then {
            assert workflow.success

            def tasks = workflow.trace.tasks().collect { it.name }

            assert tasks.findAll { it.contains("CTRL_FLUORESCENCE_DATA") }.isEmpty()
            assert tasks.findAll { it.contains("CTRL_FLUORESCENCE_PLOTS") }.isEmpty()

            // Core processes still run
            assert tasks.any { it.contains("QC") }
            assert tasks.any { it.contains("PREPROCESS") }
            assert tasks.any { it.contains("IMPUTE") }
        }
    }

