                """
            }
        }

        then {
            assert workflow.success
            def tasks = workflow.trace.tasks().collect { it.name }

            // EPIGENETIC_AGE_INFERENCE runs once
            assert tasks.findAll { it.contains("EPIGENETIC_AGE_INFERENCE") }.size() == 1

            // EPIGENETIC_AGE_PLOTS uses `each epi_clock`, so one task per clock
            assert tasks.findAll { it.contains("EPIGENETIC_AGE_PLOTS") }.size() == 2
        }
    }

