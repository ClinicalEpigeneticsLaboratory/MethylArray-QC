// Tests for the methylarrayqc_analysis subworkflow.
//
// All tests run in Nextflow stub mode (`options "-stub"`) so no actual IDAT
// files or Docker containers are required.  Stub mode skips every process
// script block and creates empty output files matching the declared output
// patterns, while the Groovy orchestration layer (branching, channel wiring,
// countLines) executes exactly as in production.
//
// Test-data files used:
//   tests/test_data/sample_sheet_small.csv        –  5 samples  (≤ 10 → PCA/AO skipped)
//   tests/test_data/sample_sheet_boundary_10.csv  – 10 samples  (≤ 10 → PCA/AO skipped)
//   tests/test_data/sample_sheet_boundary_11.csv  – 11 samples  (> 10 → PCA/AO executed)
//   tests/test_data/sample_sheet_large.csv        – 15 samples  (> 10 → PCA/AO executed)
//   tests/test_data/sample_sheet_with_age_and_sex.csv – 15 samples with Sex & Age columns
//   tests/test_data/idats/                        – empty placeholder IDAT directory

nextflow_workflow {

    name "Test Subworkflow methylarrayqc_analysis"
    script "subworkflows/methylarrayqc_analysis.nf"
    workflow "methylarrayqc_analysis"

    // ================================================================
    // HAPPY PATH – large dataset, all features enabled
    // ================================================================

    test("Happy path: large dataset (>10 samples), all features enabled") {
        options "-stub"

        when {
            params {
                output                  = "results"
                ctrl_intens_plots       = true
                ctrl_intens_metric      = "total"
                ctrl_intens_cols        = "Sentrix_ID,Sentrix_Position"
                prep_code               = "QCDPB"
                collapse_prefix         = false
                collapse_prefix_method  = "mean"
                p_threshold             = 0.2
                s_threshold             = 0.2
                imputer_type            = "knn"
                contamination           = "auto"
                n_rand_cpgs             = 10000
                nan_per_probe_n_cpgs    = 1000
                perc_pca_cpgs           = 10
                pca_number_of_components = 5
                pca_columns             = "Sentrix_ID,Sentrix_Position"
                pca_matrix_PC_count     = 5
                infer_sex               = true
                infer_epi_age           = true
                epi_clocks              = "HannumG2013,HorvathS2013"
            }
            workflow {
                """
                input[0]  = file("${projectDir}/tests/test_data/idats")
                input[1]  = file("${projectDir}/tests/test_data/sample_sheet_large.csv")
                input[2]  = 4
                input[3]  = false
                input[4]  = "mean"
                input[5]  = 0.2
                input[6]  = 0.2
                input[7]  = "QCDPB"
                input[8]  = true
                input[9]  = "total"
                input[10] = "Sentrix_ID,Sentrix_Position"
                input[11] = "knn"
                input[12] = "auto"
                input[13] = 10000
                input[14] = 1000
                input[15] = 10
                input[16] = 5
                input[17] = "Sentrix_ID,Sentrix_Position"
                input[18] = 5
                input[19] = true
                input[20] = true
                input[21] = "HannumG2013,HorvathS2013"
                """
            }
        }

        then {
            assert workflow.success

            def tasks = workflow.trace.tasks().collect { it.name }

            // Core processes must always run
            assert tasks.any { it.contains("ADDITIONAL_VALIDATORS_INIT") }
            assert tasks.any { it.contains("QC") }
            assert tasks.any { it.contains("PREPROCESS") }
            assert tasks.any { it.contains("IMPUTE") }
            assert tasks.any { it.contains("ADDITIONAL_VALIDATORS_AFTER_IMPUTE") }
            assert tasks.any { it.contains("BATCH_EFFECT") }
            assert tasks.any { it.contains("BETA_DISTRIBUTION") }
            assert tasks.any { it.contains("NAN_DISTRIBUTION_PER_SAMPLE") }
            assert tasks.any { it.contains("NAN_DISTRIBUTION_PER_PROBE") }

            // Large dataset (> 10 samples) → PCA and anomaly detection must run
            assert tasks.any { it.contains("ANOMALY_DETECTION") }
            assert tasks.any { it.contains("PCA") }

            // Optional features enabled → these must run
            assert tasks.any { it.contains("SEX_INFERENCE") }
            assert tasks.any { it.contains("EPIGENETIC_AGE_INFERENCE") }
            assert tasks.any { it.contains("EPIGENETIC_AGE_PLOTS") }
            assert tasks.any { it.contains("CTRL_FLUORESCENCE_DATA") }
            assert tasks.any { it.contains("CTRL_FLUORESCENCE_PLOTS") }
        }
    }

    // ================================================================
    // HAPPY PATH – small dataset, all features enabled
    // ================================================================

    test("Happy path: small dataset (≤10 samples), all features enabled – PCA and anomaly detection skipped") {
        options "-stub"

        when {
            params {
                output                  = "results"
                ctrl_intens_plots       = true
                ctrl_intens_metric      = "total"
                ctrl_intens_cols        = "Sentrix_ID,Sentrix_Position"
                prep_code               = "QCDPB"
                collapse_prefix         = false
                collapse_prefix_method  = "mean"
                p_threshold             = 0.2
                s_threshold             = 0.2
                imputer_type            = "knn"
                contamination           = "auto"
                n_rand_cpgs             = 10000
                nan_per_probe_n_cpgs    = 1000
                perc_pca_cpgs           = 10
                pca_number_of_components = 5
                pca_columns             = "Sentrix_ID,Sentrix_Position"
                pca_matrix_PC_count     = 5
                infer_sex               = true
                infer_epi_age           = true
                epi_clocks              = "HannumG2013,HorvathS2013"
            }
            workflow {
                """
                input[0]  = file("${projectDir}/tests/test_data/idats")
                input[1]  = file("${projectDir}/tests/test_data/sample_sheet_small.csv")
                input[2]  = 2
                input[3]  = false
                input[4]  = "mean"
                input[5]  = 0.2
                input[6]  = 0.2
                input[7]  = "QCDPB"
                input[8]  = true
                input[9]  = "total"
                input[10] = "Sentrix_ID,Sentrix_Position"
                input[11] = "knn"
                input[12] = "auto"
                input[13] = 10000
                input[14] = 1000
                input[15] = 10
                input[16] = 5
                input[17] = "Sentrix_ID,Sentrix_Position"
                input[18] = 5
                input[19] = true
                input[20] = true
                input[21] = "HannumG2013,HorvathS2013"
                """
            }
        }

        then {
            assert workflow.success

            def tasks = workflow.trace.tasks().collect { it.name }

            // Core processes must always run
            assert tasks.any { it.contains("ADDITIONAL_VALIDATORS_INIT") }
            assert tasks.any { it.contains("QC") }
            assert tasks.any { it.contains("PREPROCESS") }
            assert tasks.any { it.contains("IMPUTE") }
            assert tasks.any { it.contains("ADDITIONAL_VALIDATORS_AFTER_IMPUTE") }
            assert tasks.any { it.contains("BATCH_EFFECT") }
            assert tasks.any { it.contains("BETA_DISTRIBUTION") }
            assert tasks.any { it.contains("NAN_DISTRIBUTION_PER_SAMPLE") }
            assert tasks.any { it.contains("NAN_DISTRIBUTION_PER_PROBE") }

            // Small dataset (≤ 10 samples) → PCA and anomaly detection must NOT run
            assert tasks.findAll { it.contains("ANOMALY_DETECTION") }.isEmpty()
            assert tasks.findAll { it.contains("PCA") }.isEmpty()
        }
    }

    // ================================================================
    // CONDITIONAL BRANCH – ctrl_intens_plots
