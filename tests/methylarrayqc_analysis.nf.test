        then {
            assert workflow.success
            def tasks = workflow.trace.tasks().collect { it.name }
            // 11 > 10 → PCA and AO must run
            assert tasks.any { it.contains("ANOMALY_DETECTION") }
            assert tasks.any { it.contains("PCA") }
        }
    }

