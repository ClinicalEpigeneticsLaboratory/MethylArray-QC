    // ================================================================
    // EDGE CASES – sample count boundary (> 10 condition)
    // ================================================================

    test("Edge case: exactly 10 samples – PCA and anomaly detection not executed") {
        options "-stub"

        when {
            params {
                output                  = "results"
                ctrl_intens_plots       = false
                ctrl_intens_metric      = "total"
                ctrl_intens_cols        = "Sentrix_ID,Sentrix_Position"
                prep_code               = "QCDPB"
                collapse_prefix         = false
                collapse_prefix_method  = "mean"
                p_threshold             = 0.2
                s_threshold             = 0.2
                imputer_type            = "knn"
                contamination           = "auto"
                n_rand_cpgs             = 10000
                nan_per_probe_n_cpgs    = 1000
                perc_pca_cpgs           = 10
                pca_number_of_components = 5
                pca_columns             = "Sentrix_ID,Sentrix_Position"
                pca_matrix_PC_count     = 5
                infer_sex               = false
                infer_epi_age           = false
                epi_clocks              = "HannumG2013"
            }
            workflow {
                """
                input[0]  = file("${projectDir}/tests/test_data/idats")
                input[1]  = file("${projectDir}/tests/test_data/sample_sheet_boundary_10.csv")
                input[2]  = 2
                input[3]  = false
                input[4]  = "mean"
                input[5]  = 0.2
                input[6]  = 0.2
                input[7]  = "QCDPB"
                input[8]  = false
                input[9]  = "total"
                input[10] = "Sentrix_ID,Sentrix_Position"
                input[11] = "knn"
                input[12] = "auto"
                input[13] = 10000
                input[14] = 1000
                input[15] = 10
                input[16] = 5
                input[17] = "Sentrix_ID,Sentrix_Position"
                input[18] = 5
                input[19] = false
                input[20] = false
                input[21] = "HannumG2013"
                """
            }
        }

        then {
            assert workflow.success
            def tasks = workflow.trace.tasks().collect { it.name }
            // Condition is strictly > 10, so 10 samples must NOT trigger PCA/AO
            assert tasks.findAll { it.contains("ANOMALY_DETECTION") }.isEmpty()
            assert tasks.findAll { it.contains("PCA") }.isEmpty()
        }
    }

