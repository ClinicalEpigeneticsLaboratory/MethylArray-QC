docker {
    enabled = true
}

process {
    withLabel: "r_clock" {
        container = "patrycjaprzybylowicz92/methyl-array-qc-r-clock:0.1.1"
    }

    withLabel: "r_sesame" {
        container = "patrycjaprzybylowicz92/methyl-array-qc-r:0.1.0"
    }

    withLabel: "python" {
        container = "patrycjaprzybylowicz92/methyl-array-qc-python:0.1.0"
    }
}

plugins { 
    id 'nf-schema@2.3.0' 
}

validation {
    help {
        enabled = true
        command = "nextflow run methyl-array_qc.nf --params-file test_params_config.json"
    }
}

params {
    cpus = -1
    collapse_prefix = false
    collapse_prefix_method = "mean"
    p_threshold = 0.2
    s_threshold = 0.2
    prep_code = "QCDPB"
    ctrl_intens_plots = true
    ctrl_intens_metric = "total"
    ctrl_intens_cols = "Sentrix_ID,Sentrix_Position"
    imputer_type = "knn"
    n_rand_cpgs = 10000
    nan_per_probe_n_cpgs = 1000
    perc_pca_cpgs = 10
    contamination = 'auto' // either auto or float (0, 0.5], for more info see https://scikit-learn.org/stable/modules/outlier_detection.html#
    pca_number_of_components = 5
    pca_columns = 'Sentrix_ID,Sentrix_Position'
    pca_matrix_PC_count = 5
    infer_sex = true
    output_format = 'html' // report output format: html (interactive qc_report.html, default), pdf (static binary qc_report.pdf) or json (single structured qc_report.json)
    report_language = 'en' // report language: en (English, default) or pl (Polish) - localises all reader-facing report text and plot labels
    infer_epi_age = true
    epi_clocks = 'HannumG2013,HorvathS2013'
}

// NOTE: Run `bash examples/fetch_example_data.sh` (or `make fetch_example_data`)
// before using the test profile — the input directory must be pre-populated.
profiles {
    test {
        params {
            input        = "${projectDir}/examples/idats"
            output       = "${projectDir}/examples/results"
            sample_sheet = "${projectDir}/examples/sample_sheet.csv"
            prep_code    = "QCDPB"
            n_rand_cpgs           = 5000
            nan_per_probe_n_cpgs  = 500
            pca_number_of_components = 5
            pca_matrix_PC_count      = 3
            pca_columns              = "Sentrix_ID,Sample_Group"
            infer_sex         = true
            infer_epi_age     = true
            epi_clocks        = "HannumG2013,HorvathS2013"
            ctrl_intens_plots = true
            ctrl_intens_cols  = "Sentrix_ID,Sample_Group"
        }
    }
}

report {
    overwrite = true
}

dag {
    overwrite = true
}
